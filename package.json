{
    "name": "adabas-tcp",
    "version": "1.1.7",
    "description": "High level Adabas access package using a TCP connection",
    "keywords": [
        "adabas",
        "database",
        "tcp"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
        "fdt": "jest -t FDT",
        "lint": "tsc --noEmit && eslint src spec --fix",
        "test": "jest --watchAll"
    },
    "author": "Software GmbH",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SoftwareAG/adabas-tcp.git"
    },
    "bugs": "https://github.com/SoftwareAG/adabas-tcp/issues",
    "files": [
        "dist/**/*"
    ],
    "dependencies": {
        "pino": "^10.3.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/config": "^3.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.3.3",
        "config": "^3.3.1",
        "eslint": "^9.39.5",
        "globals": "^17.9.0",
        "jest": "^30.4.2",
        "pino-pretty": "^13.1.3",
        "ts-jest": "^29.4.12",
        "typescript": "^5.1.6",
        "typescript-eslint": "^8.66.0"
    },
    "overrides": {
        "@babel/core": "^7.29.7"
    }
}
